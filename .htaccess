RewriteEngine On

# Consolidated rewrites for static assets under /public
RewriteRule ^(css|js|images|fonts)/(.*)$ public/$1/$2 [L]

# HTML files (explicit mappings)
RewriteRule ^dashboard$ public/dashboard.html [L]

# Pretty URLs for admin HTML pages
RewriteRule ^admin-configs$ public/admin-configs.html [L]
RewriteRule ^admin-tenants$ public/admin-tenants.html [L]
RewriteRule ^admin-mappings$ public/admin-mappings.html [L]
RewriteRule ^admin-resources$ public/admin-resources.html [L]
RewriteRule ^admin-migrations$ public/admin-migrations.html [L]
RewriteRule ^admin-events$ public/admin-events.html [L]
RewriteRule ^admin-webhooks$ public/admin-webhooks.html [L]
# Favicon - serve empty response to prevent 404s
RewriteRule ^favicon\.ico$ - [R=204,L]

# Images and other static assets are handled by the consolidated rule above

# Route all other requests (API endpoints) to index.php if file/directory doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Security headers
<IfModule mod_headers.c>
  # Security headers (use set to avoid duplicates)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Set proper MIME types for static files
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType text/html .html
</IfModule>

# Cache static assets for better performance
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
        ExpiresDefault "access plus 1 month"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, immutable"
    </IfModule>
    </FilesMatch>
</IfModule>

# Gzip compression for text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Suppress .map file requests (deny access)
<Files ~ "\.map$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Protect dotfiles
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to .git directory and all its contents
RewriteRule (^|/)\.git/ - [F,L]

# Protect configuration files and sensitive directories
<FilesMatch "\.(ini|log|sh|inc|bak|sql|git|svn|htaccess|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Additional protection for sensitive files and directories
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.env\.example$ - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^(vendor|src|storage|database)/ - [F,L]

# Disable directory browsing
Options -Indexes

# PHP settings (if PHP is loaded as Apache module)
<IfModule mod_php.c>
  php_flag display_errors off
  php_flag log_errors on
  php_flag register_globals off
  php_flag allow_url_fopen off
  php_flag expose_php off
</IfModule>