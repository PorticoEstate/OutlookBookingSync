# Docker Compose environment variables (container runtime)
# NOTE: This file is used by docker-compose via `env_file:` and is separate from the app `.env`.

# API key used by ApiKeyMiddleware and cron jobs inside the container
API_KEY=change-me-strong-random

# Optional HTTP proxies available to the container (leave empty if not used)
http_proxy=http://proxy.srv.bergenkom.no:8080
https_proxy=http://proxy.srv.bergenkom.no:8080

# Feature flags
ENABLE_LEGACY_WEBHOOKS=false

# Maintenance retention (days) for bridge_sync_logs cleanup (default 30 if unset)
CLEANUP_DAYS=30
