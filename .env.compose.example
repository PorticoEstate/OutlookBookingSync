# Docker Compose environment variables (container runtime)
# NOTE: This file is used by docker-compose via `env_file:` and is separate from the app `.env`.

# API key used by ApiKeyMiddleware and cron jobs inside the container
API_KEY=change-me-strong-random

# Optional HTTP proxies for outbound requests from inside the container.
# Leave empty in most environments. If required, set to your corporate proxy URL.
# Example: http_proxy=http://proxy.example.com:8080
#          https_proxy=http://proxy.example.com:8080
http_proxy=
https_proxy=


# Webhook immediate processing configuration
WEBHOOK_IMMEDIATE_PROCESSING=true
WEBHOOK_MAX_PROCESSING_TIME=10
WEBHOOK_MAX_ATTEMPTS=3

# Maintenance retention (days) for bridge_sync_logs cleanup (default 30 if unset)
CLEANUP_DAYS=30

# Webhook subscription renewal threshold (minutes). The hourly cron will renew
# any active subscriptions expiring within this window. Default 1440 (24h).
RENEW_MINUTES=1440

# Multi-tenant mode configuration for cron jobs
TENANT_MODE=multi
ENABLE_MULTI_TENANT_SYNC=true