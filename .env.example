DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db
DB_USER=your_user
DB_PASS=your_password

API_KEY=your_api_key


# Microsoft Graph API for Outlook Bridge
OUTLOOK_CLIENT_ID=your_client_id
OUTLOOK_CLIENT_SECRET=your_client_secret
OUTLOOK_TENANT_ID=your_tenant_id
OUTLOOK_GROUP_ID=your_group_id_for_room_calendars

# Booking System API Configuration
BOOKING_SYSTEM_API_URL=http://your-booking-system/api
BOOKING_SYSTEM_LOGIN=your_booking_system_username
BOOKING_SYSTEM_PASSWORD=your_booking_system_password
BOOKING_SYSTEM_DOMAIN=your_booking_system_domain
BOOKING_SYSTEM_DEFAULT_AGEGROUP_ID=1
BOOKING_SYSTEM_DEFAULT_TARGETAUDIENCE_ID=7
BOOKING_SYSTEM_DEFAULT_ACTIVITY_ID=1

# Set to false if you want silent failures (not recommended)
BOOKING_SYSTEM_THROW_ON_FAILURE=true

# Application Configuration  
APP_BASE_URL=http://localhost:8082

# Session Configuration for Bridge System
SESSION_NAME=BRIDGE_SESSION
SESSION_LIFETIME=3600
SESSION_PREFIX=bridge_

# Proxy Configuration
httpproxy_server=http://your-proxy-server
httpproxy_port=8080
# Webhook configuration for Outlook change notifications
WEBHOOK_BASE_URL=https://your-webhook-server.com
WEBHOOK_CLIENT_SECRET=your_webhook_client_secret
# Optional: Uncomment and set the following if you need to use a proxy for the Graph API
