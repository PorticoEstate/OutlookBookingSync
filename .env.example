DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db
DB_USER=your_user
DB_PASS=your_password

# Note on docker: API Key is set in .env.compose
#API_KEY=your_api_key

APP_ENV=development
# Set to 'production' in a production environment

# Set to false if you want silent failures (not recommended)
BOOKING_SYSTEM_THROW_ON_FAILURE=true

DEFAULT_TENANT_ID=your_default_tenant_id

# Application Configuration
# Used in links/webhooks; clients must send header: X-API-Key: $API_KEY
APP_BASE_URL=http://localhost:8082

# Session Configuration for Bridge System
SESSION_NAME=BRIDGE_SESSION
SESSION_LIFETIME=3600
SESSION_PREFIX=bridge_

# Optional: Webhook validation secret if used by a bridge
WEBHOOK_CLIENT_SECRET=your_webhook_client_secret

# Queue Processing Configuration
# Enable immediate queue processing when PHP-FPM is available (default: true)
# When true and fastcgi_finish_request() is available, sync operations process immediately after queueing
# When false or PHP-FPM unavailable, sync operations wait for cron job processing
SYNC_IMMEDIATE_PROCESSING=true


